# Google Gemini API Key (Required for live AI generation)
# Obtain your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Set preferred Gemini model (e.g., gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash
